APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000
APP_TIMEZONE=Asia/Jakarta
# 1 = halaman root (/) diarahkan ke Swagger UI (/docs); 0 = halaman ringkas saja
SWAGGER_HOST=0

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Jejak akses HTTP -> storage/logs/request-YYYY-MM-DD.log
LOG_HTTP=true
# Umur simpan folder log harian (hari); 0 = jangan hapus
LOG_RETENTION_DAYS=30
# Tangkap return code stored procedure untuk log audit (hanya dicatat)
DB_PROC_RETURN_CODE=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

DB_CONNECTION2=BEFA
DB_HOST2=sql.ifca.co.id
DB_PORT2=1222
DB_DATABASE2=BEFA
DB_USERNAME2=mgr
DB_PASSWORD2=
DB_ENCRYPT2=false
DB_TRUST_SERVER_CERTIFICATE2=true
DB_POOL_MAX=20
DB_REQUEST_TIMEOUT=120000

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@ifca.co.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@ifca.co.id
MAIL_FROM_NAME='IFCA SOFTWARE'
MAIL_BCC_FEEDBACK=noreply@ifca.co.id
# Set true untuk memakai konfigurasi SMTP per entity dari tabel mgr.smtp_configuration
MAIL_USE_DB_SMTP=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================
# Short URL token (pengganti Crypt::encrypt Laravel yang panjang)
# mode = db     -> payload disimpan di tabel, URL hanya berisi id pendek (10 char)
# mode = inline -> payload dipadatkan + AES-256-GCM + base64url (tanpa tabel)
# ============================================================
URL_TOKEN_MODE=db
URL_TOKEN_LENGTH=10
URL_TOKEN_TABLE=mgr.approval_url_token
URL_TOKEN_AUTO_MIGRATE=true
URL_TOKEN_TTL_DAYS=0

# FTP (StaffAction fileexist)
FTP_HOST=uat.ifca.co.id
FTP_PORT=2111
FTP_USERNAME=befa
FTP_PASSWORD=
FTP_BASE_DIR=ifca-att
