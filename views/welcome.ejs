<!--
  Halaman root. Menggantikan resources/views/welcome.blade.php milik Laravel
  yang isinya template bawaan framework (memakai Route::has(), app()->getLocale()
  dan konstanta versi Laravel) sehingga tidak relevan setelah migrasi.
-->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= appName %> - Approval BEFA</title>
    <link rel="shortcut icon" type="image/x-icon" href="<%= url('public/images/befa_header.ico') %>">
    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f6f8;
            color: #1f2933;
        }
        .wrap { max-width: 720px; margin: 0 auto; padding: 60px 24px; }
        .card {
            background: #ffffff;
            border-radius: 8px;
            padding: 32px;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
        }
        h1 { margin: 0 0 8px; font-size: 22px; color: #026735; }
        p { line-height: 1.6; }
        ul { padding-left: 20px; line-height: 1.9; }
        code { background: #eef1f4; padding: 2px 6px; border-radius: 3px; font-size: 13px; }
        .muted { color: #6b7280; font-size: 13px; margin-top: 28px; }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="card">
            <h1>Approval BEFA</h1>
            <p>Layanan pengiriman dan pemrosesan email approval (NestJS).</p>

            <p><b>Halaman &amp; endpoint utama:</b></p>
            <ul>
                <li><a href="<%= url('appr-list') %>">Approval List</a> - <code>/appr-list</code></li>
                <li><code>GET /api/connect</code> - cek koneksi database</li>
                <li><code>GET /api/info</code> - informasi runtime &amp; konfigurasi</li>
                <li><code>POST /api/maildata</code> - kirim email approval (module dinamis)</li>
                <li><code>GET /api/processdata/{module}/{status}/{token}</code> - halaman konfirmasi</li>
            </ul>

            <p class="muted">Base URL: <code><%= config('app.url') %></code></p>
        </div>
    </div>
</body>
</html>
