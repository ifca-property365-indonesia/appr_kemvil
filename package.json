  "description": "BEFA Approval Mail Gateway - NestJS migration of the Laravel approval_befa application",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
