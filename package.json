    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "dayjs": "^1.11.13",
    "ejs": "^3.1.10",
    "mssql": "^11.0.1",
    "nodemailer": "^6.9.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.5",
