{
  "name": "approval-kemvil",
  "version": "1.0.0",
  "description": "BEFA Approval Mail Gateway - NestJS migration of the Laravel approval_befa application",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "key:generate": "node scripts/key-generate.js",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "basic-ftp": "^6.2.3",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "mssql": "^12.7.11",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.5.0"
    }
  }
}
