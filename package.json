    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "key:generate": "node scripts/key-generate.js",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
